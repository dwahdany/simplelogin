{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simplelogin",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simplelogin",
      "database_id": "2cafc7a6-19ff-4e2c-af65-83929c015c6c",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "fcbb3c9c9d504d3c8b4e29a14c9eafab"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "vars": {
    "EMAIL_DOMAIN": "sl-test.wahdany.eu",
    "ALIAS_DOMAINS": "sl-test.wahdany.eu",
    "PREMIUM_ALIAS_DOMAINS": "",
    "URL": "https://simplelogin.dariush-5fc.workers.dev",
    "MAX_NB_EMAIL_FREE_PLAN": "3",
    // "rewrite" = Flask-parity forwards (From = reverse alias) via SEND_EMAIL;
    // requires the domain onboarded onto Email Sending (paid) or strict
    // receivers reject the mail. "passthrough" = message.forward() as-is.
    "FORWARD_MODE": "passthrough"
  }
}
